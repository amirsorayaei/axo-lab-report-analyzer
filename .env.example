# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in AI_API_KEY.
#   cp .env.example .env.local
# .env.local is git-ignored and must never be committed.
# Every variable here is server-side only. Never prefix one with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Provider selection: disabled | mock | openai-compatible
# - disabled          safe default; analysis returns a controlled AI_NOT_CONFIGURED error
# - mock              demo mode; returns the bundled sample extraction, labelled as such
#                     in the UI, and consumes no credits
# - openai-compatible calls any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=openai-compatible

# Your OpenRouter key. Get one at https://openrouter.ai/keys
# Left empty on purpose: set it in .env.local, never in a committed file.
AI_API_KEY=

# OpenRouter's OpenAI-compatible endpoint.
AI_BASE_URL=https://openrouter.ai/api/v1

# Chosen for extraction accuracy and reliable strict structured output rather
# than lowest price. Lab reports are dense multi-column documents, and a
# mis-transcribed value produces a confidently wrong classification.
AI_MODEL=openai/gpt-5.6-luna

# Sampling temperature, or `omit` to send no temperature field at all.
# openai/gpt-5.6-luna is a reasoning model and does NOT accept `temperature`.
# Because requests are sent with provider.require_parameters=true, including an
# unsupported parameter can leave OpenRouter with no eligible provider — so this
# must stay `omit` for that model. Determinism comes from `seed` instead.
# Set to 0 when switching to a model that does support temperature
# (for example google/gemini-2.5-flash-lite).
AI_TEMPERATURE=omit

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# Optional OpenRouter attribution headers (HTTP-Referer and X-Title). They show
# up on the OpenRouter dashboard and are never required for a request to work.
# Set AI_APP_URL to the real origin in production.
AI_APP_URL=http://localhost:3000
AI_APP_TITLE=Axo Lab Report Analyzer

# Whether the configured model accepts image input. Declared here rather than
# probed, so an image upload is refused before a request is spent.
# openai/gpt-5.6-luna accepts images (text+image+file -> text), so this is true.
# Set to false for a text-only model; PDF uploads keep working either way.
AI_SUPPORTS_IMAGES=true

# Per-file upload limit. The 8-file count limit and the 30 MB combined limit are
# fixed in src/lib/upload/formats.ts.
MAX_UPLOAD_SIZE_MB=10
