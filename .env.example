# AI provider selection: disabled | mock | openai-compatible
# - disabled          safe default; analysis returns a controlled AI_NOT_CONFIGURED error
# - mock              demo mode; returns the bundled sample extraction and is labelled as such in the UI
# - openai-compatible calls any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=disabled

# Required only when AI_PROVIDER=openai-compatible.
# Server-side only. Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

MAX_UPLOAD_SIZE_MB=10
